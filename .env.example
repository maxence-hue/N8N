# URL publique du webhook sortant n8n
N8N_OUTBOUND_WEBHOOK=https://n8n.example.com/webhook/ads-outbound
# Secret partagé pour signer les requêtes (HMAC SHA256)
N8N_SHARED_SECRET=change-me
# URL publique de l'application (utilisée pour certaines callbacks)
BASE_URL=http://localhost:3000
# Taille maximale de fichier en Mo
MAX_UPLOAD_MB=20
NEXT_PUBLIC_MAX_UPLOAD_MB=20
